# Copy to deploy/.env and fill in operator values.  Never commit the real file.
#
# Provider prices per 1M tokens.  When set the API and the LLM runtime enforce
# each task's max_cost budget and persist per-call cost.
# Defaults below are DeepSeek flash peak list prices in CNY (2026-11-11):
# input cache miss 2, output 8, cache hit 0.04.  Off-peak is 1 / 4 / 0.02.
# Re-check the provider price page before relying on these numbers.
LLM_PRICE_INPUT_PER_1M=2
LLM_PRICE_OUTPUT_PER_1M=8
LLM_PRICE_CACHE_HIT_PER_1M=0.04

# Optional alert delivery.  The observer POSTs alert JSON here once per alert.
# MACP_ALERT_WEBHOOK=https://hooks.example.invalid/macp

# ---------------------------------------------------------------------------
# Deployment bindings.  These are generated from config/macp.toml by
# `python3 deploy/render_env.py`; the values below are the standalone defaults.
# ---------------------------------------------------------------------------

MACP_PUBLIC_URL=https://localhost:9443
MACP_PUBLISH_ADDRESS=127.0.0.1
MACP_PUBLISH_PORT=9443
MACP_HTTP_PORT=8088
MACP_DB_HOST=db-standby
MACP_DB_PORT=5432
MACP_DB_NAME=macp
MACP_DB_USER=macp
MACP_WAL_ARCHIVE_DIR=/opt/macp/wal-archive
MACP_WAL_ARCHIVE_TIMEOUT=300
MACP_MCP_PROJECT=demo
