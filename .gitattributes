# Repository-wide line endings: everything textual is LF, on every platform.
# Windows editors/PowerShell default to CRLF; a CRLF *.sh breaks immediately with
# "bash\r: No such file or directory" and a CRLF python file is just embarrassing.
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sql  text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf